{
  "info": {
    "name": "Tugas 1 - Reservasi Ruang Rapat (Topik 28)",
    "description": "Koleksi pengujian RESTful API Express.js untuk NIM 2428240101. Ganti {{baseUrl}} menjadi URL lokal atau URL Vercel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "GET - Info API",
      "request": { "method": "GET", "url": "{{baseUrl}}/" }
    },
    {
      "name": "GET - Semua reservasi",
      "request": { "method": "GET", "url": "{{baseUrl}}/meeting-reservations" }
    },
    {
      "name": "GET - Reservasi berdasarkan ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/meeting-reservations/1" }
    },
    {
      "name": "GET - Filter tanggal",
      "request": { "method": "GET", "url": "{{baseUrl}}/meeting-reservations?tanggal=2026-10-05" }
    },
    {
      "name": "POST - Tambah reservasi (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"namaPemesan\": \"PT Maju Digital\",\n  \"ruang\": \"Ruang Kenanga\",\n  \"tanggal\": \"2026-10-05\",\n  \"jamMulai\": \"13:00\",\n  \"durasiJam\": 2\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/meeting-reservations"
      }
    },
    {
      "name": "POST - Gagal field wajib kosong (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"namaPemesan\": \"\",\n  \"ruang\": \"Ruang Kenanga\",\n  \"tanggal\": \"2026-10-05\",\n  \"jamMulai\": \"13:00\",\n  \"durasiJam\": 2\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/meeting-reservations"
      }
    },
    {
      "name": "PUT - Perbarui reservasi (200)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"namaPemesan\": \"PT Maju Digital Baru\",\n  \"ruang\": \"Ruang Kenanga\",\n  \"tanggal\": \"2026-10-05\",\n  \"jamMulai\": \"14:00\",\n  \"durasiJam\": 2\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/meeting-reservations/1"
      }
    },
    {
      "name": "PUT - ID tidak ditemukan (404)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"namaPemesan\": \"PT Contoh\",\n  \"ruang\": \"Ruang Kenanga\",\n  \"tanggal\": \"2026-10-05\",\n  \"jamMulai\": \"13:00\",\n  \"durasiJam\": 2\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/meeting-reservations/999"
      }
    },
    {
      "name": "DELETE - Hapus reservasi (200)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/meeting-reservations/3" }
    },
    {
      "name": "DELETE - ID tidak ditemukan (404)",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/meeting-reservations/999" }
    },
    {
      "name": "GET - Endpoint tidak ditemukan (404 JSON)",
      "request": { "method": "GET", "url": "{{baseUrl}}/endpoint-salah" }
    }
  ]
}
