      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - Filter tanggal', function () { pm.response.to.have.status(200); });",
              "pm.test('Semua hasil sesuai tanggal', function () { pm.response.json().forEach(item => pm.expect(item.tanggal).to.eql('2026-10-05')); });"
            ]
          }
        }
      ]
