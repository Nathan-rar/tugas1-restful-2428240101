{
  "info": {
    "name": "Tugas 1 - Reservasi Ruang Rapat (Topik 28)",
    "description": "Koleksi pengujian RESTful API Express.js untuk NIM 2428240101. Base URL memakai deployment Vercel produksi; ubah variable {{baseUrl}} ke URL lokal bila diperlukan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://tugas1-restful-2428240101.vercel.app"
    }
  ],
  "item": [
    {
      "name": "GET - Info API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - Info API', function () { pm.response.to.have.status(200); });",
              "pm.test('Memuat metadata Topik 28', function () { const data = pm.response.json(); pm.expect(data.nomorTopik).to.eql(28); pm.expect(data.nim).to.eql('2428240101'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Semua reservasi",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/meeting-reservations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - Data reservasi', function () { pm.response.to.have.status(200); });",
              "pm.test('Response berupa array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
